{
  "name": "Htx Number Checker API",
  "brand": "CheckNumber",
  "slug": "htx-number-checker-api",
  "repository": "checkernumber/htx-number-checker-api",
  "description": "Asynchronous file-based Htx checks.",
  "official_site": "https://checknumber.ai",
  "landing_page": "https://checknumber.ai/products/htx",
  "canonical_docs": "https://docs.checknumber.ai/htx-bulk-number-checker",
  "dashboard": "https://platform.checknumber.ai",
  "base_url": "https://api.checknumber.ai",
  "mode": "async",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "endpoints": {
    "create_task": {
      "method": "POST",
      "path": "/v1/tasks"
    },
    "get_task": {
      "method": "POST",
      "path": "/v1/gettasks"
    },
    "balance": {
      "method": "GET",
      "path": "/v1/balance"
    }
  },
  "input": {
    "file_format": "text file, one phone number, email address, or username according to service_type per line according to task type"
  },
  "products": [
    {
      "task_type": "htx",
      "name": "Number Checker",
      "doc_slug": "htx-bulk-number-checker",
      "input_kind": "phone",
      "min_numbers": 2000,
      "max_numbers": 10000000,
      "result_fields": [
        "number",
        "activated"
      ]
    },
    {
      "task_type": "htx_email",
      "name": "Email Checker",
      "doc_slug": "htx-email-checker",
      "input_kind": "email",
      "min_numbers": 2000,
      "max_numbers": 10000000,
      "result_fields": [
        "email",
        "activated"
      ]
    }
  ],
  "pricing_url": "https://checknumber.ai/pricing",
  "maintainer": "CheckNumber",
  "license": "MIT",
  "last_reviewed": "2026-08-18"
}
